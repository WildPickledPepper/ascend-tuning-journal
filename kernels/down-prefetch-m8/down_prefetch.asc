// Fixed BF16 M8 down projection; preserve original per-core K/MMAD order.
// Two versions differ only in when the next GM->L1 pack is scheduled.
#include "kernel_operator.h"
#include "acl/acl.h"
using namespace AscendC;

template<bool Prefetch> class DownM8 {
public:
    __aicore__ inline void Run(GM_ADDR xp, GM_ADDR wp, GM_ADDR yp) {
        core=GetBlockIdx();
        x.SetGlobalBuffer((__gm__ bfloat16_t*)xp,8*K);
        w.SetGlobalBuffer((__gm__ bfloat16_t*)wp,5120*K);
        y.SetGlobalBuffer((__gm__ bfloat16_t*)yp,8*5120);
        pipe.InitBuffer(ab,2*16*BK*2);
        pipe.InitBuffer(bb,2*BN*BK*2);
        pipe.InitBuffer(al,2*16*64*2);
        pipe.InitBuffer(bl,2*BN*64*2);
        pipe.InitBuffer(cb,2*16*BN*4);
        a=ab.Get<bfloat16_t>(); b=bb.Get<bfloat16_t>();
        la=al.Get<bfloat16_t>(); lb=bl.Get<bfloat16_t>(); c=cb.Get<float>();
        Clear(a); Clear(a[16*BK]);
        if constexpr(Prefetch) {
            CopyPack(0);
            SetFlag<HardEvent::MTE2_MTE1>(0);
        }
        for(int t=0;t<2*NK;++t) {
            int stage=t%2, step=t%NK, group=t/NK;
            int n=(core==22 && group==1)?80:BN;
            if constexpr(Prefetch) {
                WaitFlag<HardEvent::MTE2_MTE1>(stage);
                if(t+1<2*NK) {
                    int next=(t+1)%2;
                    if(t>0) WaitFlag<HardEvent::MTE1_MTE2>(next);
                    CopyPack(t+1);
                    SetFlag<HardEvent::MTE2_MTE1>(next);
                }
            } else {
                if(t>=2) WaitFlag<HardEvent::MTE1_MTE2>(stage);
                CopyPack(t);
                SetFlag<HardEvent::MTE2_MTE1>(stage);
                WaitFlag<HardEvent::MTE2_MTE1>(stage);
            }
            Compute(stage,step,group,n);
            PipeBarrier<PIPE_MTE1>();
            SetFlag<HardEvent::MTE1_MTE2>(stage);
            if(step==NK-1) Store(group,n);
        }
        WaitFlag<HardEvent::MTE1_MTE2>(0);
        WaitFlag<HardEvent::MTE1_MTE2>(1);
        PipeBarrier<PIPE_ALL>();
    }
private:
    static constexpr int K=17408, NK=34, BK=512, BN=112;
    __aicore__ inline int KIndex(int step) {
        if(core>=21) return step;
        if(core%2==0) return (core/2*3+step)%NK;
        return (core/2*3-1-step+2*NK)%NK;
    }
    __aicore__ inline void Clear(LocalTensor<bfloat16_t> buf) {
        InitConstValueParams<bfloat16_t> p;
        p.repeatTimes=32; p.blockNum=16; p.dstGap=0;
        p.initValue=static_cast<bfloat16_t>(0.0f);
        InitConstValue(buf,p);
    }
    __aicore__ inline void CopyPack(int t) {
        int stage=t%2, ki=KIndex(t%NK), group=t/NK;
        int row=core*224+group*BN;
        int n=(core==22 && group==1)?80:BN;
        Nd2NzParams pa{1,8,BK,0,K,16,1,1};
        Nd2NzParams pb{1,static_cast<uint16_t>(n),BK,0,K,
                       static_cast<uint16_t>(n),1,1};
        DataCopy(a[stage*16*BK],x[ki*BK],pa);
        DataCopy(b[stage*BN*BK],w[row*K+ki*BK],pb);
    }
    __aicore__ inline void Compute(int stage,int step,int group,int n) {
        for(int sub=0;sub<8;++sub) {
            int ping=mmad_index%2;
            auto aa=la[ping*16*64]; auto bw=lb[ping*BN*64];
            LoadData2DParams pa{0,4,1,0,0,false,0};
            LoadData2DParams pb{0,static_cast<uint8_t>(n/16*4),1,0,0,false,0};
            LoadData(aa,a[stage*16*BK+sub*16*64],pa);
            LoadData(bw,b[stage*BN*BK+sub*n*64],pb);
            PipeBarrier<PIPE_MTE1>();
            SetFlag<HardEvent::MTE1_M>(0);
            WaitFlag<HardEvent::MTE1_M>(0);
            MmadParams mm;
            mm.m=8; mm.n=n; mm.k=64;
            mm.cmatrixInitVal=(step==0 && sub==0);
            Mmad(c[group*16*BN],aa,bw,mm);
            PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(0);
            WaitFlag<HardEvent::M_MTE1>(0);
            ++mmad_index;
        }
    }
    __aicore__ inline void Store(int group,int n) {
        SetFlag<HardEvent::M_FIX>(0);
        WaitFlag<HardEvent::M_FIX>(0);
        FixpipeParamsV220 p;
        p.nSize=n; p.mSize=8; p.srcStride=16; p.dstStride=5120;
        p.quantPre=QuantMode_t::F322BF16;
        Fixpipe(y[core*224+group*BN],c[group*16*BN],p);
    }
    int core,mmad_index=0;
    TPipe pipe;
    TBuf<TPosition::A1> ab; TBuf<TPosition::B1> bb;
    TBuf<TPosition::A2> al; TBuf<TPosition::B2> bl; TBuf<TPosition::CO1> cb;
    LocalTensor<bfloat16_t> a,b,la,lb;
    LocalTensor<float> c;
    GlobalTensor<bfloat16_t> x,w,y;
};
extern "C" __global__ __aicore__ void down_m8_control(GM_ADDR x,GM_ADDR w,GM_ADDR y) {
    DownM8<false> op;op.Run(x,w,y);
}
extern "C" __global__ __aicore__ void down_m8_prefetch(GM_ADDR x,GM_ADDR w,GM_ADDR y) {
    DownM8<true> op;op.Run(x,w,y);
}
#ifndef __CCE_AICORE__
extern "C" void launch_down_m8(int mode,void* stream,void* x,void* w,void* y) {
    if(mode==0) down_m8_control<<<23,nullptr,stream>>>((uint8_t*)x,(uint8_t*)w,(uint8_t*)y);
    else down_m8_prefetch<<<23,nullptr,stream>>>((uint8_t*)x,(uint8_t*)w,(uint8_t*)y);
}
#endif
