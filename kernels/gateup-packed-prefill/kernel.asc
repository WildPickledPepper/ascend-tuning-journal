// 910B2 BF16 prefill gate/up; read the existing 256x256 packed weights directly.
#include "kernel_operator.h"
#include "acl/acl.h"
using namespace AscendC;

class PackedPrefill {
public:
    __aicore__ inline void Run(GM_ADDR xp, GM_ADDR wp, GM_ADDR yp, int rows, int traversal) {
        core=GetBlockIdx(); totalM=rows; order=traversal;
        x.SetGlobalBuffer((__gm__ bfloat16_t*)xp, rows*K);
        w.SetGlobalBuffer((__gm__ bfloat16_t*)wp, N*K);
        y.SetGlobalBuffer((__gm__ bfloat16_t*)yp, rows*N);
        pipe.InitBuffer(ab,2*BM*BK*2); pipe.InitBuffer(bb,2*BN*BK*2);
        pipe.InitBuffer(al,2*BM*64*2); pipe.InitBuffer(bl,2*BN*64*2);
        pipe.InitBuffer(cb,BM*BN*4);
        a=ab.Get<bfloat16_t>(); b=bb.Get<bfloat16_t>();
        la=al.Get<bfloat16_t>(); lb=bl.Get<bfloat16_t>(); c=cb.Get<float>();
        InitConstValueParams<bfloat16_t> z;
        z.repeatTimes=2*BK/16; z.blockNum=BM; z.dstGap=0;
        z.initValue=static_cast<bfloat16_t>(0.0f); InitConstValue(a,z);
        PipeBarrier<PIPE_ALL>();
        // Keep a given N tile close across M tiles to reuse its weights in L2.
        for(nt=core;nt<N/BN;nt+=23) {
            for(m0=0;m0<totalM;m0+=BM) {
                validM=totalM-m0; if(validM>BM) validM=BM;
                Copy(0); SetFlag<HardEvent::MTE2_MTE1>(0);
                for(int step=0;step<NK;++step) {
                    int stage=step%2;
                    WaitFlag<HardEvent::MTE2_MTE1>(stage);
                    if(step+1<NK) {
                        int next=(step+1)%2;
                        if(step>0) WaitFlag<HardEvent::MTE1_MTE2>(next);
                        Copy(step+1); SetFlag<HardEvent::MTE2_MTE1>(next);
                    }
                    Compute(stage,step);
                    PipeBarrier<PIPE_MTE1>(); SetFlag<HardEvent::MTE1_MTE2>(stage);
                }
                WaitFlag<HardEvent::MTE1_MTE2>(0);
                WaitFlag<HardEvent::MTE1_MTE2>(1);
                Store();
            }
        }
        PipeBarrier<PIPE_ALL>();
    }
private:
    static constexpr int BM=128,BN=256,BK=256,N=34816,K=5120,NK=20;
    __aicore__ inline int KIndex(int step) {
        if(order==0 || core>=21) return step;
        if(core%2==0) return (core/2+step)%NK;
        return (core/2-1-step+2*NK)%NK;
    }
    __aicore__ inline void Copy(int step) {
        int ki=KIndex(step), stage=step%2;
        Nd2NzParams pa{1,(uint16_t)validM,BK,0,K,BM,1,1};
        DataCopy(a[stage*BM*BK],x[m0*K+ki*BK],pa);
        DataCopyParams pb{1,4096,0,0};
        DataCopy(b[stage*BN*BK],w[(nt*NK+ki)*BN*BK],pb);
    }
    __aicore__ inline void Compute(int stage,int step) {
        for(int sub=0;sub<4;++sub) {
            int ping=mmadIndex%2;
            auto aa=la[ping*BM*64],bw=lb[ping*BN*64];
            // A1 is [K16,M16,m,k], A2 is [M16,K16,m,k].
            LoadData2DParams pa{0,4,BM/16,0,0,false,0};
            for(int mi=0;mi<(validM+15)/16;++mi)
                LoadData(aa[mi*16*64],a[stage*BM*BK+sub*64*BM+mi*256],pa);
            LoadData2DParams pb{0,64,1,0,0,false,0};
            LoadData(bw,b[stage*BN*BK+sub*BN*64],pb);
            PipeBarrier<PIPE_MTE1>();
            SetFlag<HardEvent::MTE1_M>(0); WaitFlag<HardEvent::MTE1_M>(0);
            // Keep the regular matrix layout even for a 1-row tail (GEMV
            // mode otherwise interprets A2 differently). Store only valid rows.
            MmadParams mm; mm.m=((validM+15)/16)*16;mm.n=BN;mm.k=64;
            mm.cmatrixInitVal=(step==0 && sub==0); Mmad(c,aa,bw,mm);
            PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(0); WaitFlag<HardEvent::M_MTE1>(0);
            ++mmadIndex;
        }
    }
    __aicore__ inline void Store() {
        SetFlag<HardEvent::M_FIX>(0); WaitFlag<HardEvent::M_FIX>(0);
        FixpipeParamsV220 p;p.nSize=BN;p.mSize=validM;p.srcStride=((validM+15)/16)*16;p.dstStride=N;
        p.quantPre=QuantMode_t::F322BF16;
        Fixpipe(y[m0*N+nt*BN],c,p);
        SetFlag<HardEvent::FIX_M>(0); WaitFlag<HardEvent::FIX_M>(0);
    }
    int core,totalM,order,nt,m0,validM,mmadIndex=0;
    TPipe pipe;TBuf<TPosition::A1> ab;TBuf<TPosition::B1> bb;
    TBuf<TPosition::A2> al;TBuf<TPosition::B2> bl;TBuf<TPosition::CO1> cb;
    LocalTensor<bfloat16_t> a,b,la,lb;LocalTensor<float> c;
    GlobalTensor<bfloat16_t> x,w,y;
};
extern "C" __global__ __aicore__ void packed_prefill(GM_ADDR x,GM_ADDR w,GM_ADDR y,int rows,int order) {
    PackedPrefill op;op.Run(x,w,y,rows,order);
}
#ifndef __CCE_AICORE__
extern "C" void launch_packed_prefill(void* stream,void* x,void* w,void* y,int rows,int order) {
    packed_prefill<<<23,nullptr,stream>>>((uint8_t*)x,(uint8_t*)w,(uint8_t*)y,rows,order);
}
#endif
