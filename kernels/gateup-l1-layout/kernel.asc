// 910B2 BF16 M8 gate/up. All layouts share tiling, synchronization and MMAD order.
#include "kernel_operator.h"
#include "acl/acl.h"
using namespace AscendC;
template<int Layout> class GateUp {
public:
    __aicore__ inline void Run(GM_ADDR xp, GM_ADDR wp, GM_ADDR yp) {
        core=GetBlockIdx();
        x.SetGlobalBuffer((__gm__ bfloat16_t*)xp,8*K);
        w.SetGlobalBuffer((__gm__ bfloat16_t*)wp,N*K);
        y.SetGlobalBuffer((__gm__ bfloat16_t*)yp,8*N);
        pipe.InitBuffer(ab,16*K*2); pipe.InitBuffer(bb,2*BN*BK*2);
        pipe.InitBuffer(al,2*16*64*2); pipe.InitBuffer(bl,2*BN*64*2);
        pipe.InitBuffer(cb,16*BN*4);
        a=ab.Get<bfloat16_t>(); b=bb.Get<bfloat16_t>();
        la=al.Get<bfloat16_t>(); lb=bl.Get<bfloat16_t>(); c=cb.Get<float>();
        InitConstValueParams<bfloat16_t> z;
        z.repeatTimes=K/16; z.blockNum=16; z.dstGap=0;
        z.initValue=static_cast<bfloat16_t>(0.0f); InitConstValue(a,z);
        // Complete SET_2D before ND2NZ fills A; avoid initialization/write races.
        PipeBarrier<PIPE_ALL>();
        Nd2NzParams pa{1,8,K,0,K,16,1,1}; DataCopy(a,x,pa);
        PipeBarrier<PIPE_ALL>();
        int groups=core==22?4:6, total=groups*NK;
        Copy(0); SetFlag<HardEvent::MTE2_MTE1>(0);
        for(int t=0;t<total;++t) {
            int stage=t%2, step=t%NK;
            WaitFlag<HardEvent::MTE2_MTE1>(stage);
            if(t+1<total) {
                int next=(t+1)%2;
                if(t>0) WaitFlag<HardEvent::MTE1_MTE2>(next);
                Copy(t+1); SetFlag<HardEvent::MTE2_MTE1>(next);
            }
            Compute(stage,step);
            PipeBarrier<PIPE_MTE1>(); SetFlag<HardEvent::MTE1_MTE2>(stage);
            if(step==NK-1) Store(t/NK);
        }
        WaitFlag<HardEvent::MTE1_MTE2>(0);
        WaitFlag<HardEvent::MTE1_MTE2>(1);
        PipeBarrier<PIPE_ALL>();
    }
private:
    static constexpr int N=34816,K=5120,BN=256,BK=256,NK=20;
    __aicore__ inline int KIndex(int step) {
        // Native integrated schedule: forward/reverse K shift, disabled on tail cores.
        if(core>=21) return step;
        if(core%2==0) return (core/2+step)%NK;
        return (core/2-1-step+2*NK)%NK;
    }
    __aicore__ inline void Copy(int t) {
        int group=t/NK, ki=KIndex(t%NK), tile=core*6+group, row=tile*BN;
        auto dst=b[(t%2)*BN*BK];
        if constexpr(Layout==0) {
            Nd2NzParams p{1,BN,BK,0,K,BN,1,1};
            DataCopy(dst,w[row*K+ki*BK],p);
        } else if constexpr(Layout==1) {
            // Global NZ [K/16,N/16,16,16]: 16 separated 8-KiB spans.
            DataCopyParams p{16,256,34560,0};
            DataCopy(dst,w[ki*BK*N+row*16],p);
        } else {
            // Packed [N/BN,K/BK,BK/16,BN/16,16,16]. Same bytes in L1.
            DataCopyParams p{1,4096,0,0};
            DataCopy(dst,w[(tile*NK+ki)*BN*BK],p);
        }
    }
    __aicore__ inline void Compute(int stage,int step) {
        for(int sub=0;sub<4;++sub) {
            int ping=mmad_index%2;
            auto aa=la[ping*16*64], bw=lb[ping*BN*64];
            LoadData2DParams pa{0,4,1,0,0,false,0};
            LoadData2DParams pb{0,64,1,0,0,false,0};
            LoadData(aa,a[(KIndex(step)*BK+sub*64)*16],pa);
            LoadData(bw,b[stage*BN*BK+sub*BN*64],pb);
            PipeBarrier<PIPE_MTE1>();
            SetFlag<HardEvent::MTE1_M>(0); WaitFlag<HardEvent::MTE1_M>(0);
            MmadParams mm; mm.m=8;mm.n=BN;mm.k=64;
            mm.cmatrixInitVal=(step==0 && sub==0); Mmad(c,aa,bw,mm);
            PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(0); WaitFlag<HardEvent::M_MTE1>(0);
            ++mmad_index;
        }
    }
    __aicore__ inline void Store(int group) {
        SetFlag<HardEvent::M_FIX>(0); WaitFlag<HardEvent::M_FIX>(0);
        FixpipeParamsV220 p;p.nSize=BN;p.mSize=8;p.srcStride=16;p.dstStride=N;
        p.quantPre=QuantMode_t::F322BF16;
        Fixpipe(y[(core*6+group)*BN],c,p);
        SetFlag<HardEvent::FIX_M>(0); WaitFlag<HardEvent::FIX_M>(0);
    }
    int core,mmad_index=0; TPipe pipe;
    TBuf<TPosition::A1> ab; TBuf<TPosition::B1> bb;
    TBuf<TPosition::A2> al; TBuf<TPosition::B2> bl; TBuf<TPosition::CO1> cb;
    LocalTensor<bfloat16_t> a,b,la,lb; LocalTensor<float> c;
    GlobalTensor<bfloat16_t> x,w,y;
};
extern "C" __global__ __aicore__ void gateup_nd(GM_ADDR x,GM_ADDR w,GM_ADDR y) {GateUp<0> op;op.Run(x,w,y);}
extern "C" __global__ __aicore__ void gateup_nz(GM_ADDR x,GM_ADDR w,GM_ADDR y) {GateUp<1> op;op.Run(x,w,y);}
extern "C" __global__ __aicore__ void gateup_packed(GM_ADDR x,GM_ADDR w,GM_ADDR y) {GateUp<2> op;op.Run(x,w,y);}
#ifndef __CCE_AICORE__
extern "C" void launch_gateup(int layout,void* stream,void* x,void* w,void* y) {
    if(layout==0) gateup_nd<<<23,nullptr,stream>>>((uint8_t*)x,(uint8_t*)w,(uint8_t*)y);
    else if(layout==1) gateup_nz<<<23,nullptr,stream>>>((uint8_t*)x,(uint8_t*)w,(uint8_t*)y);
    else gateup_packed<<<23,nullptr,stream>>>((uint8_t*)x,(uint8_t*)w,(uint8_t*)y);
}
#endif
