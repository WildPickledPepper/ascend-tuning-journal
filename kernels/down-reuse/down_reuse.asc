// Fixed-shape BF16 decode down projection: x[17408], w[5120,17408].
// Independent implementation; does not modify the installed CANN kernels.
#include "kernel_operator.h"
#include "acl/acl.h"
using namespace AscendC;

template<int Mode> class DownProjection {
public:
    __aicore__ inline void Run(GM_ADDR xp, GM_ADDR wp, GM_ADDR yp) {
        constexpr int K=17408, NK=34, BK=512, BN=112;
        int core=GetBlockIdx(), row=core*224;
        core_id=core;
        x.SetGlobalBuffer((__gm__ bfloat16_t*)xp,K);
        w.SetGlobalBuffer((__gm__ bfloat16_t*)wp,5120*K);
        y.SetGlobalBuffer((__gm__ bfloat16_t*)yp,5120);
        pipe.InitBuffer(ab,32768);
        pipe.InitBuffer(bb,(Mode==3?4:2)*BN*BK*2);
        pipe.InitBuffer(al,2*16*64*2);
        pipe.InitBuffer(bl,2*BN*64*2);
        pipe.InitBuffer(cb,2*16*BN*4);
        auto a=ab.Get<bfloat16_t>(); auto b=bb.Get<bfloat16_t>();
        auto la=al.Get<bfloat16_t>(); auto lb=bl.Get<bfloat16_t>();
        auto c=cb.Get<float>();
        if constexpr(Mode!=0) {
            Clear(a); Clear(a[8192]);
        }
        if constexpr(Mode==3) {
            // 480 KiB L1: two A tiles and two stages of both B subtiles.
            CopyA(a,0);
            CopyB(b,row,0,BN);
            CopyB(b[BN*BK],row+BN,0,core==22?80:BN);
            SetFlag<HardEvent::MTE2_MTE1>(0);
            for(int k=0;k<NK;++k) {
                int stage=k%2;
                WaitFlag<HardEvent::MTE2_MTE1>(stage);
                if(k+1<NK) {
                    int next=(k+1)%2;
                    if(k>0) WaitFlag<HardEvent::MTE1_MTE2>(next);
                    CopyA(a[next*8192],k+1);
                    CopyB(b[next*2*BN*BK],row,k+1,BN);
                    CopyB(b[(next*2+1)*BN*BK],row+BN,k+1,core==22?80:BN);
                    SetFlag<HardEvent::MTE2_MTE1>(next);
                }
                for(int g=0;g<2;++g) {
                    int n=(core==22 && g==1)?80:BN;
                    Compute(a[stage*8192],b[(stage*2+g)*BN*BK],la,lb,c[g*16*BN],k,n);
                }
                SetFlag<HardEvent::MTE1_MTE2>(stage);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(0);
            WaitFlag<HardEvent::MTE1_MTE2>(1);
            Store(c,row,BN); Store(c[16*BN],row+BN,core==22?80:BN);
        } else if constexpr(Mode==2) {
            for(int k=0;k<NK;++k) {
                auto aa=a[(k%2)*8192];
                CopyA(aa,k);
                for(int g=0;g<2;++g) {
                    int n=(core==22 && g==1)?80:BN;
                    auto bw=b[g*BN*BK];
                    CopyB(bw,row+g*BN,k,n);
                    Sync<HardEvent::MTE2_MTE1>();
                    Compute(aa,bw,la,lb,c[g*16*BN],k,n);
                }
                Sync<HardEvent::MTE1_MTE2>();
            }
            Store(c,row,BN); Store(c[16*BN],row+BN,core==22?80:BN);
        } else {
            for(int g=0;g<2;++g) {
                int n=(core==22 && g==1)?80:BN;
                for(int k=0;k<NK;++k) {
                    auto aa=a[(k%2)*8192];
                    if constexpr(Mode==0) Clear(aa);
                    CopyA(aa,k);
                    CopyB(b,row+g*BN,k,n);
                    Sync<HardEvent::MTE2_MTE1>();
                    Compute(aa,b,la,lb,c,k,n);
                    Sync<HardEvent::MTE1_MTE2>();
                }
                Store(c,row+g*BN,n);
                Sync<HardEvent::FIX_M>();
            }
        }
        PipeBarrier<PIPE_ALL>();
    }
private:
    template<HardEvent E> __aicore__ inline void Sync() {
        SetFlag<E>(0); WaitFlag<E>(0);
    }
    __aicore__ inline void Clear(LocalTensor<bfloat16_t> a) {
        InitConstValueParams<bfloat16_t> p;
        p.repeatTimes=32; p.blockNum=16; p.dstGap=0;
        p.initValue=static_cast<bfloat16_t>(0.0f);
        InitConstValue(a,p);
    }
    __aicore__ inline void CopyA(LocalTensor<bfloat16_t> a,int k) {
        k=KIndex(k);
        Nd2NzParams p{1,1,512,0,17408,16,1,1};
        DataCopy(a,x[k*512],p);
    }
    __aicore__ inline void CopyB(LocalTensor<bfloat16_t> b,int row,int k,int n) {
        k=KIndex(k);
        Nd2NzParams p{1,static_cast<uint16_t>(n),512,0,17408,
                     static_cast<uint16_t>(n),1,1};
        DataCopy(b,w[row*17408+k*512],p);
    }
    __aicore__ inline void Compute(LocalTensor<bfloat16_t> a,
        LocalTensor<bfloat16_t> b,LocalTensor<bfloat16_t> la,
        LocalTensor<bfloat16_t> lb,LocalTensor<float> c,int k,int n) {
        for(int sub=0;sub<8;++sub) {
            // Preserve ascending 64-element MMAD order within each K=512 tile.
            int ping=sub%2;
            auto a0=la[ping*16*64]; auto b0=lb[ping*112*64];
            LoadData2DParams pa{0,4,1,0,0,false,0};
            LoadData2DParams pb{0,static_cast<uint8_t>(n/16*4),1,0,0,false,0};
            LoadData(a0,a[sub*16*64],pa);
            LoadData(b0,b[sub*n*64],pb);
            Sync<HardEvent::MTE1_M>();
            MmadParams mm;
            mm.m=2; mm.n=n; mm.k=64;
            mm.cmatrixInitVal=(k==0 && sub==0);
            Mmad(c,a0,b0,mm);
            Sync<HardEvent::M_MTE1>();
        }
    }
    __aicore__ inline void Store(LocalTensor<float> c,int row,int n) {
        Sync<HardEvent::M_FIX>();
        FixpipeParamsV220 p;
        p.nSize=n; p.mSize=1; p.srcStride=16; p.dstStride=5120;
        p.quantPre=QuantMode_t::F322BF16;
        Fixpipe(y[row],c,p);
    }
    __aicore__ inline int KIndex(int step) {
        // Captured CANN kernel: cores 0..20 use alternating forward/reverse
        // cyclic K traversal; cores 21/22 use ordinary forward traversal.
        // Both N subtiles on each core use the SAME permutation.
        if(core_id>=21) return step;
        if(core_id%2==0) return (core_id/2*3+step)%34;
        return (core_id/2*3-1-step+68)%34;
    }
    int core_id;
    TPipe pipe;
    TBuf<TPosition::A1> ab;
    TBuf<TPosition::B1> bb;
    TBuf<TPosition::A2> al;
    TBuf<TPosition::B2> bl;
    TBuf<TPosition::CO1> cb;
    GlobalTensor<bfloat16_t> x,w,y;
};

extern "C" __global__ __aicore__ void down_baseline(GM_ADDR x,GM_ADDR w,GM_ADDR y) {
    DownProjection<0> op;op.Run(x,w,y);
}
extern "C" __global__ __aicore__ void down_hoist(GM_ADDR x,GM_ADDR w,GM_ADDR y) {
    DownProjection<1> op;op.Run(x,w,y);
}
extern "C" __global__ __aicore__ void down_reuse(GM_ADDR x,GM_ADDR w,GM_ADDR y) {
    DownProjection<2> op;op.Run(x,w,y);
}
extern "C" __global__ __aicore__ void down_pipeline(GM_ADDR x,GM_ADDR w,GM_ADDR y) {
    DownProjection<3> op;op.Run(x,w,y);
}
#ifndef __CCE_AICORE__
extern "C" void launch_down(int mode, void* stream, void* x,void* w,void* y) {
    if(mode==0) down_baseline<<<23,nullptr,stream>>>((uint8_t*)x,(uint8_t*)w,(uint8_t*)y);
    else if(mode==1) down_hoist<<<23,nullptr,stream>>>((uint8_t*)x,(uint8_t*)w,(uint8_t*)y);
    else if(mode==2) down_reuse<<<23,nullptr,stream>>>((uint8_t*)x,(uint8_t*)w,(uint8_t*)y);
    else down_pipeline<<<23,nullptr,stream>>>((uint8_t*)x,(uint8_t*)w,(uint8_t*)y);
}
#endif
